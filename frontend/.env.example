# ─────────────────────────────────────────────────────────────────────────────
# CareNova Frontend — Environment Variables
# Copy this file to .env and fill in real values for local dev.
# For Vercel, set these in the project's Environment Variables settings.
# ─────────────────────────────────────────────────────────────────────────────

# Backend API base URL (default: http://localhost:3001)
REACT_APP_API_URL=http://localhost:3001

# Demo mode — when "true", the app never calls the backend and serves
# seeded data from src/data/demoData.ts via src/lib/demoAdapter.ts instead.
# Set to "true" on Vercel until the backend is deployed.
REACT_APP_DEMO_MODE=false

# Post-login cross-subdomain redirect targets, and the signal App.tsx uses to
# decide whether the current hostname should skip the marketing landing page
# and go straight to /login (see the isAppOrAdminSubdomain check in App.tsx).
# Optional for local dev — react-router navigate('/dashboard') is the
# fallback when these are blank. Required in Vercel's Production environment
# once app.carenova.ai exists — see docs/domain-setup.md for the full
# checklist (CRA env vars are baked in at BUILD time, so setting these alone
# does nothing until the next deploy).
REACT_APP_APP_URL=https://app.carenova.ai
REACT_APP_ADMIN_URL=https://admin.carenova.ai

# Google Tag Manager container ID (optional).
REACT_APP_GTM_ID=
