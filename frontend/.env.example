# ─────────────────────────────────────────────────────────────────────────────
# CareNova Frontend — Environment Variables
# Copy this file to .env and fill in real values for local dev.
# For Vercel, set these in the project's Environment Variables settings.
# ─────────────────────────────────────────────────────────────────────────────

# Backend API base URL (default: http://localhost:3001)
REACT_APP_API_URL=http://localhost:3001

# Demo mode — when "true", the app never calls the backend and serves
# seeded data from src/data/demoData.ts via src/lib/demoAdapter.ts instead.
# Set to "true" on Vercel until the backend is deployed.
REACT_APP_DEMO_MODE=false

# Three-host architecture (src/config/hosts.ts) — which of these three
# hostnames the current page load is (marketing/app/admin), which decides
# which route tree App.tsx mounts. Optional for local dev: hosts.ts falls
# back to a same-origin ?host=app|admin|marketing query override when
# REACT_APP_DEMO_MODE=true and the matching env var is blank (see
# docs/host-setup.md for testing before real domains are attached). Required
# in Vercel's Production environment once app.carenova.ai/admin.carenova.ai
# exist — see docs/domain-setup.md (CRA env vars are baked in at BUILD time,
# so setting these alone does nothing until the next deploy).
REACT_APP_MARKETING_URL=https://carenova.ai
REACT_APP_APP_URL=https://app.carenova.ai
REACT_APP_ADMIN_URL=https://admin.carenova.ai

# Google Tag Manager container ID (optional).
REACT_APP_GTM_ID=
