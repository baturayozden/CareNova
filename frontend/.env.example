# ─────────────────────────────────────────────────────────────────────────────
# CareNova Frontend — Environment Variables
# Copy this file to .env and fill in real values for local dev.
# For Vercel, set these in the project's Environment Variables settings.
# ─────────────────────────────────────────────────────────────────────────────

# Backend API base URL (default: http://localhost:3001)
REACT_APP_API_URL=http://localhost:3001

# Demo mode — when "true", the app never calls the backend and serves
# seeded data from src/data/demoData.ts via src/lib/demoAdapter.ts instead.
# Set to "true" on Vercel until the backend is deployed.
REACT_APP_DEMO_MODE=false

# Post-login cross-subdomain redirect targets (optional — local dev falls
# back to react-router navigate('/dashboard') when these are blank).
REACT_APP_APP_URL=
REACT_APP_ADMIN_URL=

# Google Tag Manager container ID (optional).
REACT_APP_GTM_ID=
