# ─────────────────────────────────────────────────────────────────────────────
# CareDental Backend — Environment Variables
# Copy this file to .env and fill in real values for local dev.
# For production (Render.com), set these in the Render dashboard or render.yaml.
# NEVER commit .env with real secrets to git.
# ─────────────────────────────────────────────────────────────────────────────

# ── Node ───────────────────────────────────────────────────────────────────
NODE_ENV=development
PORT=3001

# ── PostgreSQL (Supabase) ──────────────────────────────────────────────────
# Supabase → Project Settings → Database → Connection string (URI)
DATABASE_URL=postgresql://postgres:[YOUR-PASSWORD]@db.[PROJECT-REF].supabase.co:5432/postgres

# ── Auth ───────────────────────────────────────────────────────────────────
# Generate strong secrets:
#   node -e "console.log(require('crypto').randomBytes(64).toString('hex'))"
JWT_SECRET=your-super-secret-jwt-key-change-in-production
JWT_REFRESH_SECRET=your-super-secret-refresh-key-change-in-production

# ── CORS ───────────────────────────────────────────────────────────────────
# In production: subdomain URLs for tenant app and platform admin
APP_URL=https://app.caredental.ai
ADMIN_URL=https://admin.caredental.ai
# Local dev: APP_URL=http://localhost:3000  ADMIN_URL=http://localhost:3001

# ── WhatsApp Business API (Meta Cloud API) ─────────────────────────────────
# Meta for Developers → Your App → WhatsApp → API Setup
WHATSAPP_ACCESS_TOKEN=your-whatsapp-access-token
WHATSAPP_PHONE_NUMBER_ID=your-phone-number-id
WHATSAPP_WEBHOOK_VERIFY_TOKEN=your-custom-verify-token-string
WHATSAPP_API_VERSION=v19.0

# ── AI Providers ───────────────────────────────────────────────────────────
ANTHROPIC_API_KEY=your-anthropic-api-key
OPENAI_API_KEY=

# ── Email (Resend) ─────────────────────────────────────────────────────────
# Resend dashboard → API Keys → Create key
# https://resend.com/api-keys
# Leave blank to fall back to console logging (fine for local dev).
RESEND_API_KEY=re_your_resend_api_key_here

# ── Supabase Storage (for patient document uploads — private bucket) ──────
# Supabase → Settings → API → service_role (secret key, NOT anon key)
# Storage bucket: 'patient-documents' (create manually, set to Private)
SUPABASE_URL=https://[PROJECT-REF].supabase.co
SUPABASE_SERVICE_ROLE_KEY=eyJ...

# ── Misc ───────────────────────────────────────────────────────────────────
CLINIC_API_SECRET=your-clinic-api-secret
